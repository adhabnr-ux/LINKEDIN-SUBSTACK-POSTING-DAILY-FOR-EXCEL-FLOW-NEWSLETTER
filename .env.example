# LinkedIn API credentials
# Get these from developer.linkedin.com → your app → OAuth 2.0 Tools
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# Gmail credentials for Substack email-to-post
# Use an App Password, NOT your real Gmail password
# Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Substack secret email-to-post address
# Substack dashboard → Settings → Email posting
SUBSTACK_POST_EMAIL=abc123@post.substack.com

# Timezone (used for display in CLI)
TZ=America/Denver
