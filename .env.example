# LinkedIn API credentials
# Get these from developer.linkedin.com → your app → OAuth 2.0 Tools
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# Substack session cookie for posting Notes via the internal API.
# Substack removed email-to-post, so the scheduler authenticates with
# your logged-in session cookie instead. See README for how to copy it.
SUBSTACK_SID=

# Timezone (used for display in CLI)
TZ=America/Denver
